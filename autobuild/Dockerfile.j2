# Build via docker:
# docker build --build-arg cores=8 -t blocknetdx/{{ walletDockerName }}:latest .

{% if build_system == 'golang' %}
# =============================================================================
# Go daemon build (btcd-family: node daemon + its wallet facade).
# Multi-stage: golang builder compiles the Go binaries; the runtime stage is a
# plain ubuntu image (no gcc/g++/depends toolchain).
# =============================================================================
{% set daemon_rpc_port = daemon_rpc_port | default((walletRPCPort | int + 10000) | string) %}
{% set daemon_stem = daemon_stem | default(walletDaemon[:-1]) %}
FROM golang:1.19 AS builder

ARG cores=6
ENV ecores=$cores

LABEL wallet={{ walletName }}
LABEL version={{ walletGitTag }}

# Build the node daemon + its CLI.
RUN git clone --depth 1 --branch {{ walletGitTag }} {{ walletGitURL }} {{ walletLinuxDir }} \
  && cd {{ walletLinuxDir }} \
  && go install -v . ./cmd/...

{% if wallet_repo %}
# Build the companion wallet facade (pinned in build_config.py COIN_OVERRIDES).
RUN git clone --depth 1 --branch {{ wallet_tag }} {{ wallet_repo }} {{ daemon_stem }}wallet \
  && cd {{ daemon_stem }}wallet \
  && go install -v .
{% endif %}

FROM ubuntu:{{ buildOS }}

ARG cores=6
ENV ecores=$cores

LABEL wallet={{ walletName }}
LABEL version={{ walletGitTag }}

ENV TZ=UTC
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt update \
  && apt install -y --no-install-recommends \
      ca-certificates curl \
  && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Copy the Go binaries built in the builder stage
COPY --from=builder /go/bin/{{ walletDaemon }} /usr/bin/{{ walletDaemon }}
COPY --from=builder /go/bin/{{ daemon_stem }}ctl /usr/bin/{{ daemon_stem }}ctl
{% if wallet_repo %}
COPY --from=builder /go/bin/{{ daemon_stem }}wallet /usr/bin/{{ daemon_stem }}wallet
{% endif %}

RUN mkdir -p /opt/blockchain/config \
  && mkdir -p /opt/blockchain/config_init \
  && mkdir -p /opt/blockchain/data \
  && ln -s /opt/blockchain/config /root/.{{ walletDaemon }} \
{% if wallet_repo %}
  && ln -s /opt/blockchain/config /root/.{{ daemon_stem }}wallet
{% endif %}

# Node daemon config -- RPC bound to localhost only (notls requires it);
# the legacy facade (if present) is served by the wallet binary on the
# exposed port.
RUN printf "datadir=/opt/blockchain/data\n\
rpcuser=test\n\
rpcpass={{ default_rpc_pass }}\n\
rpclisten=127.0.0.1:{{ daemon_rpc_port }}\n\
notls=1\n\
listen=0.0.0.0:{{ walletPort }}\n\
txindex=1\n\
maxpeers=16\n" > /opt/blockchain/config_init/{{ walletConfName }}

{% if wallet_repo %}
# Wallet facade config -- legacy RPC on the exposed port.
RUN printf "appdata=/opt/blockchain/data\n\
rpcconnect=127.0.0.1:{{ daemon_rpc_port }}\n\
noclienttls=1\n\
noservertls=1\n\
rpclisten=0.0.0.0:{{ walletRPCPort }}\n\
rpcuser=test\n\
rpcpass={{ default_rpc_pass }}\n\
passphrase={{ default_rpc_pass }}\n" > /opt/blockchain/config_init/{{ daemon_stem }}wallet.conf

# CLI shim -> <coin>ctl against the wallet facade's legacy RPC.
RUN printf '#!/bin/sh\nexec /usr/bin/{{ daemon_stem }}ctl --wallet --notls --rpcserver=127.0.0.1:{{ walletRPCPort }} -u ${RPC_USER:-test} -P ${RPC_PASSWORD:-{{ default_rpc_pass }}} "$@"\n' > /usr/bin/{{ daemon_stem }}-cli \
  && chmod +x /usr/bin/{{ daemon_stem }}-cli
{% endif %}

# Entrypoint: start the node, wait for its RPC, auto-create the wallet on
# first boot (if a facade is present), then run the facade (or node) in the
# foreground as PID 1. Credentials are applied from RPC_USER/RPC_PASSWORD env
# at startup so the EXR stack can inject its own.
RUN cat > /opt/blockchain/start.sh <<'EOF'
#!/bin/bash
set -e
# The EXR stack bind-mounts a host dir over /opt/blockchain/config, which would
# shadow the configs baked into the image. Seed them from the non-shadowed
# config_init dir on first boot (guarded so restarts never clobber edits).
mkdir -p /opt/blockchain/config
[ -f /opt/blockchain/config/{{ walletConfName }} ] || cp /opt/blockchain/config_init/{{ walletConfName }} /opt/blockchain/config/{{ walletConfName }}
{% if wallet_repo %}
[ -f /opt/blockchain/config/{{ daemon_stem }}wallet.conf ] || cp /opt/blockchain/config_init/{{ daemon_stem }}wallet.conf /opt/blockchain/config/{{ daemon_stem }}wallet.conf
{% endif %}
sed -i "s/^rpcuser=.*/rpcuser=${RPC_USER:-test}/; s/^rpcpass=.*/rpcpass=${RPC_PASSWORD:-{{ default_rpc_pass }}}/" \
  /opt/blockchain/config/{{ walletConfName }}{% if wallet_repo %} /opt/blockchain/config/{{ daemon_stem }}wallet.conf{% endif %}

# Forward SIGTERM/SIGINT to the node + wallet facade so `docker stop` shuts them
# down gracefully (avoids SIGKILL / unclean LevelDB/Pebble DB on the chain).
cleanup() {
  kill -TERM "$WALLET_PID" "$LBCD_PID" 2>/dev/null
  wait 2>/dev/null
  exit 0
}
trap cleanup TERM INT

/usr/bin/{{ walletDaemon }} -C /opt/blockchain/config/{{ walletConfName }} &
LBCD_PID=$!
for i in $(seq 1 60); do
  /usr/bin/{{ daemon_stem }}ctl --notls --rpcserver=127.0.0.1:{{ daemon_rpc_port }} -u ${RPC_USER:-test} -P ${RPC_PASSWORD:-{{ default_rpc_pass }}} getblockchaininfo >/dev/null 2>&1 && break
  sleep 2
done
{% if wallet_repo %}
if [ ! -f /opt/blockchain/data/mainnet/wallet.db ]; then
  # 'no' declines an existing seed; 'OK' acknowledges the generated seed.
  # These answers are pinned to lbcwallet v0.13.111's --create prompt sequence.
  printf 'no\nOK\n' | /usr/bin/{{ daemon_stem }}wallet -C /opt/blockchain/config/{{ daemon_stem }}wallet.conf --create || echo "wallet create failed, continuing"
fi
/usr/bin/{{ daemon_stem }}wallet -C /opt/blockchain/config/{{ daemon_stem }}wallet.conf &
WALLET_PID=$!
wait $WALLET_PID
{% else %}
wait $LBCD_PID
{% endif %}
EOF
RUN chmod +x /opt/blockchain/start.sh

WORKDIR /opt/blockchain/
VOLUME ["/opt/blockchain/config", "/opt/blockchain/data"]

# P2P, Legacy RPC (wallet facade)
EXPOSE {{ walletPort }} {{ walletRPCPort }}

CMD ["/opt/blockchain/start.sh"]
{% else %}
FROM ubuntu:{{ buildOS }}

ARG cores=6
ENV ecores=$cores

LABEL wallet={{ walletName }}
LABEL version={{ walletGitTag }}

ENV TZ=UTC
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt update \
  && apt install -y --no-install-recommends \
     software-properties-common \
     ca-certificates \
      wget curl git \
     build-essential libtool autotools-dev automake \
     pkg-config bsdmainutils bison python3 libgmp-dev cmake ninja-build \
{% if apt_extra %}
     {{ apt_extra }} \
{% endif %}
  && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

ENV DISTDIR=/opt/blockchain/dist

# Build source
RUN mkdir -p /opt/{{ walletLinuxDir }} \
  && mkdir -p /opt/blockchain/config \
  && mkdir -p /opt/blockchain/data \
  && ln -s /opt/blockchain/config /root/.{{ walletLinuxDir }} \
  && cd /opt/{{ walletLinuxDir }} \
{% if git_ref %}
  && git clone{{ git_clone_flags }} --depth 1 {{ walletGitURL }} {{ walletLinuxDir }} \
  && cd {{ walletLinuxDir }} \
  && git fetch --depth 1 origin {{ git_ref }} \
  && git checkout FETCH_HEAD \
  && git submodule update --init --recursive --depth 1 \
  && cd /opt/{{ walletLinuxDir }}/{{ walletLinuxDir }}/ \
{% else %}
  && git clone{{ git_clone_flags }} --depth 1 --branch {{ walletGitTag }} {{ walletGitURL }} {{ walletLinuxDir }} \
  && cd /opt/{{ walletLinuxDir }}/{{ walletLinuxDir }}/ \
{% endif %}
{% if source_subdir %}
  && cd {{ source_subdir }} \
{% endif %}
{% if build_system == 'makefile_unix' %}
  && cd src \
{% for cmd in depends_prep %}
  && {{ cmd }} \
{% endfor %}
  && make "USE_NATIVETOR=-" -f makefile.unix INNOVA_SPINNER=0 -j$ecores \
{% for cmd in post_build %}
  && {{ cmd }} \
{% endfor %}
  && cp {{ walletDaemon }} /usr/bin/ \
  && ln -s {{ walletDaemon }} /usr/bin/{{ walletDaemon[:-1] }}-cli \
{% else %}
  && cd depends \
{% for cmd in depends_prep %}
  && {{ cmd }} \
{% endfor %}
&& make -j$ecores NO_QT=1 \
{% set platformPath = platform_path if platform_path else 'x86_64-pc-linux-gnu' %}
{% if build_system == 'cmake' %}
&& cd .. \
&& mkdir -p build && cd build \
&& cmake -GNinja .. -DCMAKE_TOOLCHAIN_FILE=../cmake/platforms/Linux64.cmake -DCMAKE_TOOLCHAIN_PREFIX=x86_64-pc-linux-gnu -DCMAKE_C_COMPILER={{ cc }} -DCMAKE_CXX_COMPILER={{ cxx }} -DCMAKE_CXX_FLAGS="-Wno-error=return-type" -DBUILD_BITCOIN_QT=OFF -DENABLE_MAN=OFF \
&& ninja -j$ecores \
{% for cmd in post_build %}
&& {{ cmd }} \
{% endfor %}
&& DESTDIR=$DISTDIR ninja install \
{% elif build_system == 'cmake_core' %}
&& cd .. \
&& cmake -B build -DCMAKE_TOOLCHAIN_FILE=depends/{{ platformPath }}/toolchain.cmake -DCMAKE_CXX_FLAGS="-Wno-error=return-type" -DBUILD_TESTS=OFF -DBUILD_BENCH=OFF -DINSTALL_MAN=OFF \
&& cmake --build build -j $ecores \
{% for cmd in post_build %}
&& {{ cmd }} \
{% endfor %}
&& DESTDIR=$DISTDIR cmake --install build \
{% else %}
&& cd .. \
&& chmod +x ./autogen.sh \
&& ./autogen.sh \
&& ./configure CC="{{ cc }}" CXX="{{ cxx }}" CXXFLAGS="-Wno-error=return-type" --with-gui=no --enable-hardening{% if configure_flags %} {{ configure_flags }}{% endif %} --prefix=`pwd`/depends/{{ platformPath }} \
&& make -j$ecores {{ make_args }}\
{% for cmd in post_build %}
&& {{ cmd }} \
{% endfor %}
&& make install DESTDIR=$DISTDIR \
{% endif %}
  {% if build_system == 'cmake' or build_system == 'cmake_core' %}
  && cp $DISTDIR/usr/local/bin/* /usr/bin/ \
  {% else %}
  && cp $DISTDIR/opt/{{ walletLinuxDir }}/{{ walletLinuxDir }}{% if source_subdir %}/{{ source_subdir }}{% endif %}/depends/{{ platformPath }}/bin/* /usr/bin/ \
  {% endif %}
{% endif %}
  && rm -rf /opt/{{ walletLinuxDir }}/

# Write default {{ walletConfName }} (can be overridden on commandline)
RUN echo "datadir=/opt/blockchain/data  \n\
                                        \n\
dbcache=256                             \n\
maxmempool=512                          \n\
                                        \n\
rpcuser=test                            \n\
rpcpassword={{ default_rpc_pass }}                    \n\
                                        \n\
port={{ walletPort }}                              \n\
rpcport={{ walletRPCPort }}                           \n\
                                        \n\
listen=1                                \n\
txindex=1                               \n\
server=1                                \n\
maxconnections=16                       \n\
{% for addr in addnodes %}addnode={{ addr }}                    \n\
{% endfor %}logtimestamps=1                         \n\
logips=1                                \n\
                                        \n\
rpcallowip=127.0.0.1                    \n\
rpctimeout=30                           \n\
rpcclienttimeout=30                     \n" > /opt/blockchain/config/{{ walletConfName }}

WORKDIR /opt/blockchain/
VOLUME ["/opt/blockchain/config", "/opt/blockchain/data"]

# Port, RPC, Test Port, Test RPC
EXPOSE {{ walletPort }} {{ walletRPCPort }}  {{ testnetPort }}  {{ testnetRPC }}

{% if tail_debuglog %}
# {{ walletName }} daemon logs to debug.log only (fPrintToConsole=false), so
# stream it to stdout via tail -F; daemon stays PID 1 for clean shutdown.
CMD ["/bin/bash", "-c", "tail -F /opt/blockchain/data/debug.log & exec /usr/bin/{{ walletDaemon }} -daemon=0"]
{% elif launch_flags %}
# {{ walletName }} daemon needs extra launch option(s).
CMD ["/usr/bin/{{ walletDaemon }}", "-daemon=0"{% for flag in launch_flags %}, "{{ flag }}"{% endfor %}]
{% else %}
CMD ["/usr/bin/{{ walletDaemon }}", "-daemon=0"]
{% endif %}
{% endif %}
